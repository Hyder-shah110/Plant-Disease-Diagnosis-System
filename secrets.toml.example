# SETUP INSTRUCTIONS:
# 1. Create a folder named ".streamlit" in your project root (same folder as main.py)
# 2. Copy this file into that folder and rename it to "secrets.toml"
# 3. Replace the value below with your NEW Groq API key (generate one at console.groq.com/keys
#    after revoking the old exposed key)
# 4. Never commit secrets.toml to git - add ".streamlit/secrets.toml" to your .gitignore

GROQ_API_KEY = "paste-your-new-groq-key-here"
